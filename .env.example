# Supabase — browser-safe
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<anon-key>

# Supabase — server-side only (never expose to the browser)
SUPABASE_SERVICE_ROLE_KEY=<service-role-key>

# Nylas — server-side only
NYLAS_API_KEY=<nylas-api-key>
NYLAS_CLIENT_ID=<nylas-client-id>
NYLAS_CLIENT_SECRET=<nylas-client-secret>
NYLAS_API_URI=https://api.us.nylas.com
NYLAS_STATE_SECRET=<random-secret-for-oauth-state>

# Site URL — used in Nylas OAuth redirect URI (no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Asana — per-coordinator PATs are stored in the DB (asana_access_token column).
# No global token is needed. Run this migration if the column doesn't exist yet:
#   ALTER TABLE users ADD COLUMN IF NOT EXISTS asana_access_token text;

# Skill runtime
SIMPLIFI_CALLER_EMAIL=<coordinator-email>
